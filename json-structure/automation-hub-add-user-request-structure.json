{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/uipath/refs/heads/main/json-structure/automation-hub-add-user-request-structure.json",
  "name": "AddUserRequest",
  "description": "Request payload for adding a new user to Automation Hub",
  "type": "object",
  "required": [
    "email",
    "role"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the user to add",
      "example": "user@example.com"
    },
    "role": {
      "type": "string",
      "description": "Role to assign to the user",
      "example": "example-value"
    }
  }
}