{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/uipath/refs/heads/main/json-structure/platform-management-user-structure.json",
  "name": "User",
  "description": "A user account in the UiPath organization",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the user",
      "example": "abc123"
    },
    "name": {
      "type": "string",
      "description": "Display name of the user",
      "example": "Example Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the user",
      "example": "user@example.com"
    },
    "isActive": {
      "type": "boolean",
      "description": "Whether the user account is active",
      "example": true
    },
    "createdOn": {
      "type": "datetime",
      "description": "ISO 8601 timestamp when the user was created",
      "example": "2026-01-15T10:30:00Z"
    },
    "lastLoginDate": {
      "type": "datetime",
      "description": "ISO 8601 timestamp of the user's most recent login",
      "example": "2026-01-15T10:30:00Z"
    }
  }
}