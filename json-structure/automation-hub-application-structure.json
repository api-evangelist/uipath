{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/uipath/refs/heads/main/json-structure/automation-hub-application-structure.json",
  "name": "Application",
  "description": "A business application entry in the application inventory",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "id": {
      "type": "int32",
      "description": "Unique integer identifier of the application",
      "example": 12345
    },
    "name": {
      "type": "string",
      "description": "Display name of the application",
      "example": "Example Name"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor or provider of the application",
      "example": "example-value"
    },
    "category": {
      "type": "string",
      "description": "Category classification of the application",
      "example": "example-value"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the application",
      "example": "Example description for this resource."
    }
  }
}