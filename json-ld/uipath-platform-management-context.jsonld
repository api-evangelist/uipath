      "@id": "uipath:organizationId",
      "@type": "xsd:string"
    },
    "actorId": {
      "@id": "uipath:actorId",
      "@type": "xsd:string"
    },
    "actorEmail": {
      "@id": "uipath:actorEmail",
      "@type": "xsd:string"
    },
    "eventType": {
      "@id": "uipath:eventType",
      "@type": "xsd:string"
    },
    "eventSource": {
      "@id": "uipath:eventSource",
      "@type": "xsd:string"
    },
    "eventTarget": {
      "@id": "uipath:eventTarget",
      "@type": "xsd:string"
    },
    "eventDetails": {
      "@id": "uipath:eventDetails",
      "@type": "@id"
    },
    "eventSummary": {
      "@id": "uipath:eventSummary",
      "@type": "xsd:string"
    },
    "status": {
      "@id": "uipath:status",
      "@type": "xsd:integer"
    },
    "clientInfo": {
      "@id": "uipath:clientInfo",
      "@type": "xsd:string"
    },
    "name": "schema:name",
    "targets": {
      "@id": "uipath:targets",
      "@container": "@set",
      "@type": "xsd:string"
    },
    "sources": {
      "@id": "uipath:sources",
      "@container": "@set",
      "@type": "xsd:string"
    },
    "ipAddress": {
      "@id": "uipath:ipAddress",
      "@type": "xsd:string"
    },
    "country": {
      "@id": "uipath:country",
