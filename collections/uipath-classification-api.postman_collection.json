          "id": "7a1bb60c-bae7-475f-bc6d-d114c888cb51",
          "name": "UiPath Get Asynchronous Classification Result",
          "request": {
            "name": "UiPath Get Asynchronous Classification Result",
            "description": {
              "content": "Retrieves the result of an asynchronous classification request by its requestId. The job status can be NotStarted, Running, Failed, or Succeeded. Poll this endpoint until the status is Succeeded or Failed. Results are available for 24 hours from the time the job completed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "classification",
                ":requestId",
                "result"
              ],
              "host": [
                "{{baseUrl}}"
              ],
