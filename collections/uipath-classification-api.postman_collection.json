          "id": "98c1b004-8788-42ef-873a-c376eb37babb",
          "name": "UiPath Start Asynchronous Document Classification",
          "request": {
            "name": "UiPath Start Asynchronous Document Classification",
            "description": {
              "content": "Submits a previously digitized document for asynchronous classification. Returns a requestId to poll for results. Asynchronous mode is suited for multi-page documents and concurrent batch workloads. Results are retained for 24 hours. Use GET /classification/{requestId}/result to retrieve the classification outcome once processing is complete.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "classification",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "1",
                  "description": "API version to use for this request"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) Unique identifier of the Document Understanding project"
                },
                {
                  "description": "The name of your UiPath organization",
                  "type": "any",
                  "value": "{{orgName}}",
                  "key": "orgName"
                },
                {
                  "description": "The name of your UiPath tenant",
                  "type": "any",
                  "value": "{{tenantName}}",
                  "key": "tenantName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
