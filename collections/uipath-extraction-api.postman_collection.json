        {
          "id": "daa9e04a-7a04-49b1-b220-2e3d930de192",
          "name": "UiPath Get Asynchronous Extraction Result",
          "request": {
            "name": "UiPath Get Asynchronous Extraction Result",
            "description": {
              "content": "Retrieves the result of an asynchronous extraction request by its requestId. The job status can be NotStarted, Running, Failed, or Succeeded. Poll this endpoint until the status is Succeeded or Failed. Returns extracted field values with associated confidence scores. Results are available for 24 hours from the time the job completed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "extraction",
                ":requestId",
                "result"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
