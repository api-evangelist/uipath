          "id": "e56b1fa9-f7ac-45b6-94b5-a35670a5dde4",
          "name": "UiPath Start Asynchronous Document Extraction",
          "request": {
            "name": "UiPath Start Asynchronous Document Extraction",
            "description": {
              "content": "Submits a previously digitized document for asynchronous data extraction. The extractors to apply and the document type must be specified in the request body. Returns a requestId to poll for results. Results are retained for 24 hours. Use GET /extraction/{requestId}/result to retrieve extracted field values once processing completes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "extraction",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "1",
                  "description": "API version to use for this request"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) Unique identifier of the Document Understanding project"
                },
                {
                  "description": "The name of your UiPath organization",
                  "type": "any",
                  "value": "{{orgName}}",
                  "key": "orgName"
                },
                {
                  "description": "The name of your UiPath tenant",
                  "type": "any",
                  "value": "{{tenantName}}",
                  "key": "tenantName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
