                  "value": "<string>",
                  "description": "OData filter expression to narrow results (e.g., State eq 'Running')"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of records to return (default 100, max 1000)"
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination"
                }
