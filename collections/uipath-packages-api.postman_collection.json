                  "description": "The name of your UiPath organization",
                  "type": "any",
                  "value": "{{orgName}}",
                  "key": "orgName"
                },
                {
                  "description": "The name of your UiPath tenant",
                  "type": "any",
                  "value": "{{tenantName}}",
                  "key": "tenantName"
                }
              ]
            },
            "header": [
