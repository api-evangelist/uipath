          "name": "UiPath List Requirements in a Project",
          "request": {
            "name": "UiPath List Requirements in a Project",
            "description": {
              "content": "Retrieves all requirements defined within a specific test project. Requirements represent business or technical specifications that test cases are mapped to for traceability. Supports pagination. Requires the TM.Requirements or TM.Requirements.Read OAuth scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "projects",
                ":projectId",
                "requirements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
