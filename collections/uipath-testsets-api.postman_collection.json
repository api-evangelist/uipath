          "name": "UiPath List Test Sets in a Project",
          "request": {
            "name": "UiPath List Test Sets in a Project",
            "description": {
              "content": "Retrieves all test sets within a specific test project. Test sets group test cases for coordinated execution runs and can be linked to Orchestrator processes to trigger automated execution.",
              "type": "text/plain"
            },
