          "name": "UiPath Digitize a Document",
          "request": {
            "name": "UiPath Digitize a Document",
            "description": {
              "content": "Submits a document for digitization, converting it into a structured digital representation that can be used for classification, extraction, and validation. Supported input formats are JPEG, PNG, PDF, and TIFF. The response includes a documentId that must be used in subsequent classification, extraction, and validation requests. Digitized results are retained for seven days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "digitization",
                "start"
              ],
